# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
coverage/

# Environment files (keep secrets and machine-specific config out of Git).
# .env.example documents the variable names and IS committed.
.env
.env.*
!.env.example
*.local

# Client brand source files (original logos, licensed .otf fonts, brand
# guide PDF). Kept locally for reference; not redistributed. The site uses
# its own derived assets in src/ and public/.
brand/
*.pdf
*.otf

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.sw?

# OS files
.DS_Store
Thumbs.db
desktop.ini
