# Copy to .env (or set in your hosting provider's build settings).
# Never commit real environment files.

# Optional override for the site URL (no trailing slash). Defaults to the
# production domain https://sapphireadvisorygroup.co.uk (src/data/seo.js),
# so a normal production build needs nothing here. Set only for
# non-production builds, e.g. a staging preview.
# Used for canonical URLs, og:url, structured data, robots.txt and sitemap.xml.
VITE_SITE_URL=
